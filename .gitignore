.env
.env.*
!.env.example

# Локальные сертификаты и закрытые ключи не должны попадать в Git.
certs/*
!certs/.gitkeep
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# Файлы с учётными данными.
credentials*.json
credentials*.yml
credentials*.yaml
secrets*.json
secrets*.yml
secrets*.yaml

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv
venv

# Логи и артефакты локальных прогонов/E2E-тестов
*.log
worker_logs.txt
final*.txt
test*.txt
temp_*.py
e2e_test*.py
/tmp/

# IDE
.vscode/
.idea/

# Docker
*.pid
